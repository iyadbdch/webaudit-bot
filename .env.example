PORT=4000
NODE_ENV=development

# Database (SQLite for dev)
DB_TYPE=sqlite
DB_PATH=./data/webaudit.db

# PostgreSQL (for production)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=webaudit
# DB_PASSWORD=webaudit
# DB_NAME=webaudit

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenWA Connection
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=your-api-key
OPENWA_SESSION_ID=your-session-uuid

# WhatsApp notification settings
WHATSAPP_NOTIFY_CHAT_ID=phone@c.us
WHATSAPP_ENABLED=false

# Audit script path (PowerShell WebAudit.ps1)
AUDIT_SCRIPT_PATH=./scripts/WebAudit.ps1

# Lighthouse CLI path
LIGHTHOUSE_PATH=npx lighthouse

# Default check intervals (minutes)
DEFAULT_UPTIME_INTERVAL=5
DEFAULT_CHANGE_INTERVAL=60
DEFAULT_AUDIT_INTERVAL=1440
DEFAULT_LIGHTHOUSE_INTERVAL=1440

# Report schedules
DAILY_REPORT_HOUR=8
WEEKLY_REPORT_DAY=1
WEEKLY_REPORT_HOUR=9
